# QuickCut (快剪) 环境变量配置示例
# 请复制为 .env 或在系统环境变量中配置（切勿将真实密钥提交到 Git 仓库）

# --- 语音听写 (ASR / STT) ---
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_STT_MODEL=

DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=
DEEPGRAM_STT_MODEL=

# --- AI 文稿校对与翻译 (Gemini / Vertex AI / Antigravity) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
VERTEX_API_KEY=
GOOGLE_CLOUD_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
QUICKCUT_REVIEW_MODEL=
QUICKCUT_ANTIGRAVITY_CLI=

# --- 本地运行时与媒体工具路径（可选覆盖） ---
QUICKCUT_SUPPORT_ROOT=
QUICKCUT_MEDIA_ROOT=
QUICKCUT_WHISPER_CLI=
QUICKCUT_WHISPER_MODEL=
